datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  PASTRY_CHEF     // Confeiteiro (Painel de Produção)
  DELIVERY_DRIVER // Entregador
  SELLER          // Vendedor / Parceiro Marketplace
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING       // Em produção na cozinha
  DECORATING      // Fase de finalização artística
  READY_TO_SHIP   // Aguardando entregador
  SHIPPING        // Rota de entrega em tempo real
  DELIVERED
  CANCELLED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role          @default(CUSTOMER)
  avatarUrl     String?
  cashbackVal   Decimal       @default(0.00) @db.Decimal(10, 2)
  loyaltyPoints Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  addresses     Address[]
  orders        Order[]       @relation("CustomerOrders")
  assignedOrders Order[]      @relation("DriverOrders")
  reviews       Review[]
  favorites     Favorite[]
  chatMessages  ChatMessage[]
  sellerProfile SellerProfile?
}

model SellerProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName     String    @unique
  description   String?
  rating        Float     @default(5.0)
  logoUrl       String?
  bannerUrl     String?
  bankDetails   Json?     // Detalhes de repasse financeiro
  products      Product[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  latitude     Float?   // Para cálculo preciso de frete e rota
  longitude    Float?
  isDefault    Boolean  @default(false)
}

model Product {
  id            String         @id @default(uuid())
  sellerId      String?
  seller        SellerProfile? @relation(fields: [sellerId], references: [id])
  name          String
  slug          String         @unique
  description   String
  price         Decimal        @db.Decimal(10, 2)
  promoPrice    Decimal?       @db.Decimal(10, 2)
  stock         Int            @default(0)
  images        String[]
  category      String
  occasion      String[]       // casamento, aniversario, infantil, corporativo
  rating        Float          @default(5.0)
  isFeatured    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  
  orderItems    OrderItem[]
  reviews       Review[]
  favorites     Favorite[]
}

model CustomCakeOrder {
  id             String    @id @default(uuid())
  size           String    // Ex: "20 fatias - 2kg"
  batter         String    // Massa: chocolate, baunilha, etc.
  filling        String    // Recheio: brigadeiro belga, pistache, frutas vermelhas
  frosting       String    // Cobertura: buttercream, ganache, pasta americana
  decoration     String    // Tipo de decoração
  topperText     String?   // Texto no topo
  colors         String[]  // Paleta de cores solicitada
  notes          String?   // Observações especiais
  deliveryDate   DateTime
  deliveryPeriod String    // Manhã, Tarde, Noite
  referencePics  String[]  // Links de imagens enviadas no upload
  priceEstimate  Decimal   @db.Decimal(10, 2)
  
  orderItem      OrderItem?
}

model Order {
  id             String      @id @default(uuid())
  customerId     String
  customer       User        @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId       String?
  driver         User?       @relation("DriverOrders", fields: [driverId], references: [id])
  status         OrderStatus @default(PENDING)
  total          Decimal     @db.Decimal(10, 2)
  discount       Decimal     @default(0.00) @db.Decimal(10, 2)
  shippingCost   Decimal     @db.Decimal(10, 2)
  cashbackUsed   Decimal     @default(0.00) @db.Decimal(10, 2)
  paymentMethod  String      // PIX, CREDIT_CARD, MERCADO_PAGO
  paymentStatus  String      // PENDING, PAID, REFUNDED
  deliveryEta    DateTime?   // Horário estimado de entrega
  currentLat     Float?      // Rastreamento em tempo real
  currentLng     Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  items          OrderItem[]
  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
}

model OrderItem {
  id                String           @id @default(uuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])
  customCakeOrderId String?          @unique
  customCake        CustomCakeOrder? @relation(fields: [customCakeOrderId], references: [id])
  quantity          Int
  price             Decimal          @db.Decimal(10, 2)
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, productId])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountValue  Decimal   @db.Decimal(10, 2)
  isPercentage   Boolean   @default(false)
  minOrderValue  Decimal?  @db.Decimal(10, 2)
  expiresAt      DateTime
  isActive       Boolean   @default(true)
  
  orders         Order[]
}

model ChatMessage {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  isAdminMsg Boolean  @default(false)
  createdAt  DateTime @default(now())
}
