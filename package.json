{
  "name": "territorio-doce-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Full-Stack Premium de Confeitaria de Luxo e Marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run start:dev --workspace=apps/server",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/database/prisma/schema.prisma"
  },
  "keywords": [
    "nextjs",
    "nestjs",
    "prisma",
    "postgresql",
    "threejs",
    "gsap",
    "luxury",
    "cake",
    "marketplace"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "prisma": "^5.12.0",
    "typescript": "^5.4.0"
  }
}
